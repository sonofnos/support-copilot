NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://support:support@localhost:5436/support_copilot

REDIS_URL=redis://localhost:6380

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# Local-first AI: leave unset to run entirely on Ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2:1b

# Optional hosted fallback (any OpenAI-compatible endpoint: OpenAI, Groq, LiteLLM proxy...).
# Leave both unset to fall back further to a deterministic in-process fake (zero cost, used in tests).
AI_API_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=768

INBOUND_WEBHOOK_SECRET=dev-webhook-secret-change-me
